# Copie para .env (gitignored) e preencha com valores reais.
# Nunca commite .env — ele já está no .gitignore deste projeto.

# Config do projeto Firebase (ver services/firebaseConfig.js).
 EXPO_PUBLIC_APIKEY = 
    EXPO_PUBLIC_AUTHDOMAIN = 
    EXPO_PUBLIC_PROJECTID =
    EXPO_PUBLIC_STORAGEBUCKET = 
    EXPO_PUBLIC_MESSAGINGSENDERID = 
    EXPO_PUBLIC_APPID = 

# Client ID "Web" do Google Sign-In (ver src/context/LoginContext.js).
# Sem isso, o login com Google fica desabilitado (googlePronto = false).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# URL base da API própria (DFS-backend), usada pelo cliente HTTP (ver services/api.js).
EXPO_PUBLIC_API_LINK=
