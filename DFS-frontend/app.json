{
  "expo": {
    "name": "DFS",
    "slug": "DFS",
    "version": "1.0.0",
    "scheme": "dfs",
    "orientation": "portrait",
    "icon": "./assets/DFS-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/DFS-icon.png"
      },
      "package": "com.anonymous.DFS",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/DFS-icon-no-background.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E5421A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/DFS-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "7a007283-c5cc-48e2-9b25-bb1d8ce141ff"
      }
    },
    "owner": "theo-souza"
  }
}
