{
  "expo": {
    "name": "DFS",
    "slug": "DFS",
    "version": "1.0.0",
    "scheme": "dfs",
    "orientation": "portrait",
    "icon": "./assets/DFS-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/DFS-icon.png"
      },
      "package": "com.anonymous.DFS",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7a007283-c5cc-48e2-9b25-bb1d8ce141ff"
      }
    },
    "owner": "theo-souza"
  }
}
