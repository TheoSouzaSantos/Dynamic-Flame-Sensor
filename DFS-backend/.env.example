# Copie para .env (gitignored) e preencha com valores reais.
# Nunca commite .env — ele já está no .gitignore deste projeto.

# Segredo usado para assinar/verificar os tokens de placa (ver utils/signToken.js, middleware/autenticar.js).
API_SECRET=

# Caminho para a chave de conta de serviço do Firebase Admin SDK (ver config/db.js).
# Localmente: ../firebase-key.json. No Render: /etc/secrets/firebase-key.json.
FIREBASE_KEY_PATH=

# Porta da API. Opcional — se omitida, usa 3000 (ver server.js).
PORT=

# Chave web (não secreta) do projeto Firebase — o mesmo valor de
# EXPO_PUBLIC_APIKEY do DFS-frontend. Usada só pela página pública de
# redefinição de senha (ver rotas/paginaResetSenha.js) pra chamar a API REST
# accounts:resetPassword do Firebase direto do navegador do usuário.
FIREBASE_WEB_API_KEY=
