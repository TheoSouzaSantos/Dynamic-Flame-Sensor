@baseUrl = http://localhost:3000

### Re-login da placa — captura um token de device
# @name loginPlaca
POST {{baseUrl}}/auth/dispositivo
Content-Type: application/json

{
  "placaId": "COLE_O_PLACA_ID",
  "secret": "COLE_O_DEVICE_SECRET_CRU"
}

### Leitura em repouso (rode 2x — a 2ª não deve gravar)
POST {{baseUrl}}/sensores/leitura
Content-Type: application/json
Authorization: Bearer {{loginPlaca.response.body.accessToken}}

{
  "estado": "normal",
  "leitura": 90
}

### Virada pra gás — deve gravar (estado mudou)
POST {{baseUrl}}/sensores/leitura
Content-Type: application/json
Authorization: Bearer {{loginPlaca.response.body.accessToken}}

{
  "estado": "gas",
  "leitura": 950
}

### Estado inválido → 400
POST {{baseUrl}}/sensores/leitura
Content-Type: application/json
Authorization: Bearer {{loginPlaca.response.body.accessToken}}

{
  "estado": "qualquer",
  "leitura": 10
}

### Usuário tentando postar leitura → 403
POST {{baseUrl}}/sensores/leitura
Content-Type: application/json
Authorization: Bearer COLE_UM_ID_TOKEN_DE_USUARIO

{ "estado": "chama", "leitura": 900 }

### Rate limit — dispare 12x seguidas, as últimas devem dar 429
POST {{baseUrl}}/auth/dispositivo
Content-Type: application/json

{ "placaId": "qualquer", "secret": "qualquer" }

### Placa revogada tentando postar leitura → 403
# (revogue antes com PATCH /placas/{id}, depois use um token dela)
POST {{baseUrl}}/sensores/leitura
Content-Type: application/json
Authorization: Bearer {{loginPlaca.response.body.accessToken}}

{ "estado": "gas", "leitura": 900 }

